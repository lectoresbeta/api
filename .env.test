APP_ENV=test
APP_DEBUG=0
APP_SECRET=test
KERNEL_CLASS='LectoresBeta\Shared\Infrastructure\Symfony\Kernel'
SYMFONY_DEPRECATIONS_HELPER=max[self]=0
MESSENGER_TRANSPORT_DSN=in-memory://
MAILER_DSN=null://null
MAILER_SENDER="Lectores Beta <hola@lectoresbeta.test>"
ACTIVATION_URL_TEMPLATE="http://localhost/activar?token={token}"
INVITATION_URL_TEMPLATE="http://localhost/registro?invitacion={token}"
PASSWORD_RESET_URL_TEMPLATE="http://localhost/restablecer?token={token}"
EMAIL_CHANGE_URL_TEMPLATE="http://localhost/confirmar-correo?token={token}"

# Los ficheros de los tests van a su propio directorio, que se borra con
# `var/`: sin esto, una prueba dejaría avatares en el almacén de desarrollo.
APP_STORAGE_DIR=%kernel.project_dir%/var/storage-test
WORK_SHARE_URL_TEMPLATE="http://localhost/obras/{id}"
POST_SHARE_URL_TEMPLATE="http://localhost/publicaciones/{id}"
