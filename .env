# Valores por defecto para desarrollo. Los secretos reales NUNCA van aquí:
# .env.local está en .gitignore y es donde se sobreescriben.
#
# AGENTS.md: "Never commit secrets."

APP_ENV=dev
APP_DEBUG=1
APP_SECRET=cambiame_en_env_local

# PostgreSQL — un esquema por bounded context (decisión P-1)
DATABASE_URL="postgresql://lectoresbeta:lectoresbeta@127.0.0.1:5432/lectoresbeta?serverVersion=16&charset=utf8"

# RabbitMQ — transporte de los eventos de integración
MESSENGER_TRANSPORT_DSN=amqp://lectoresbeta:lectoresbeta@127.0.0.1:5672/%2f/messages

# Correo — en desarrollo, Mailpit en http://localhost:8025
MAILER_DSN=smtp://127.0.0.1:1025
MAILER_SENDER=no-reply@lectoresbeta.com

# JWT (decision:0007). Las claves se generan con:
#   make jwt-keys
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=cambiame_en_env_local

# Dirección a la que se recurre un bloqueo por reclamación (FEAT-MOD-003)
MODERATION_APPEALS_EMAIL=reclamaciones@lectoresbeta.com
