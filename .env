# Valores por defecto para desarrollo. Los secretos reales NUNCA van aquí:
# .env.local está en .gitignore y es donde se sobreescriben.
#
# AGENTS.md: "Never commit secrets."

APP_ENV=dev
APP_DEBUG=1
APP_SECRET=cambiame_en_env_local

# URL pública de la API. La necesita el router para generar enlaces fuera de
# una petición HTTP: el correo de activación lo manda un worker de Messenger,
# que no tiene Host del que deducirla.
DEFAULT_URI=http://localhost:8000

# PostgreSQL — un esquema por bounded context (decisión P-1)
DATABASE_URL="postgresql://lectoresbeta:lectoresbeta@127.0.0.1:5432/lectoresbeta?serverVersion=16&charset=utf8"

# RabbitMQ — transporte de los eventos de integración
MESSENGER_TRANSPORT_DSN=amqp://lectoresbeta:lectoresbeta@127.0.0.1:5672/%2f/messages

# Correo — en desarrollo, Mailpit en http://localhost:8025
MAILER_DSN=smtp://127.0.0.1:1025
MAILER_SENDER=no-reply@lectoresbeta.com

# JWT (decision:0007). Las claves se generan con:
#   make jwt-keys
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=cambiame_en_env_local

# Dónde se guardan los ficheros subidos (FEAT-USR-037). En desarrollo, un
# directorio del propio proyecto; en producción, un volumen persistente — o un
# adaptador de almacenamiento de objetos, que es un cambio de una sola clase.
APP_STORAGE_DIR=%kernel.project_dir%/var/storage

# Entrar con Google (FEAT-USR-002). Las credenciales se sacan de la consola de
# Google Cloud, y **aquí no va ninguna**: en desarrollo se ponen en
# `.env.local`, que no se versiona, y en producción son variables del entorno.
# Vacías, el botón de Google no funciona; nada más de la aplicación se entera.
#
# `GOOGLE_OAUTH_REDIRECT_URI` es la página **del frontend** que recoge el
# código y lo manda a la API, y tiene que estar declarada igual en la consola
# de Google: el proveedor exige que sea la misma en los dos pasos.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI="http://localhost:3000/auth/google/callback"

# Dirección a la que se recurre un bloqueo por reclamación (FEAT-MOD-003)
MODERATION_APPEALS_EMAIL=reclamaciones@lectoresbeta.com

###> lectoresbeta/notification ###
# Remitente de los correos transaccionales.
MAILER_SENDER="Lectores Beta <hola@lectoresbeta.com>"
# Página del frontend que recoge el token del enlace y lo envía a la API.
# `{token}` se sustituye al generar el correo.
ACTIVATION_URL_TEMPLATE="http://localhost:3000/activar?token={token}"
INVITATION_URL_TEMPLATE="http://localhost:3000/registro?invitacion={token}"
PASSWORD_RESET_URL_TEMPLATE="http://localhost:3000/restablecer?token={token}"
EMAIL_CHANGE_URL_TEMPLATE="http://localhost:3000/confirmar-correo?token={token}"

# Dónde vive cada cosa en el frontend, para poder componer el enlace que se
# comparte fuera (FEAT-WRK-011, FEAT-COM-020). Son **direcciones canónicas**,
# no enlaces generados: no llevan token, no caducan y no abren nada que no
# fuera ya público.
WORK_SHARE_URL_TEMPLATE="http://localhost:3000/obras/{id}"
POST_SHARE_URL_TEMPLATE="http://localhost:3000/publicaciones/{id}"
###< lectoresbeta/notification ###
