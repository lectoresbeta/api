<?xml version="1.0" encoding="utf-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <!-- Proyección de una decisión de `Credits`. Se reconstruye reprocesando
         `ChapterCorrectabilityChanged` y no es fuente de verdad de nada. -->
    <entity name="LectoresBeta\Feedback\Correction\Domain\Entity\CorrectableChapter"
            table="correctable_chapter" schema="feedback_ctx">

        <id name="chapterId" column="chapter_id" type="guid">
            <generator strategy="NONE"/>
        </id>

        <field name="workId" column="work_id" type="guid"/>
        <field name="correctable" type="boolean"/>
        <field name="changedAt" column="changed_at" type="datetime_immutable"/>

    </entity>

</doctrine-mapping>
