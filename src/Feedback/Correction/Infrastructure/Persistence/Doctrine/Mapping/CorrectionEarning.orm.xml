<?xml version="1.0" encoding="utf-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <!--
        El eco de lo que `Credits` pagó por una corrección (`FEAT-FBK-010`).
        La clave es la corrección: una fila por corrección pagada, y el hecho
        reentregado no crea una segunda.
    -->
    <entity name="LectoresBeta\Feedback\Correction\Domain\Entity\CorrectionEarning"
            table="correction_earning" schema="feedback_ctx">

        <id name="correctionId" column="correction_id" type="guid">
            <generator strategy="NONE"/>
        </id>

        <field name="credits" type="integer"/>
        <field name="recordedAt" column="recorded_at" type="datetime_immutable"/>

    </entity>

</doctrine-mapping>
