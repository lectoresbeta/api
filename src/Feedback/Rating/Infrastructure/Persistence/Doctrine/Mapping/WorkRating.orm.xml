<?xml version="1.0" encoding="utf-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="LectoresBeta\Feedback\Rating\Domain\Entity\WorkRating"
            table="work_rating" schema="feedback_ctx">

        <indexes>
            <index name="idx_work_rating_work" columns="work_id"/>
        </indexes>

        <unique-constraints>
            <unique-constraint name="uniq_work_rating_reader" columns="work_id,reader_id"/>
        </unique-constraints>

        <id name="id" type="guid" column="id">
            <generator strategy="NONE"/>
        </id>

        <field name="workId" column="work_id" type="guid"/>
        <field name="readerId" column="reader_id" type="guid"/>
        <field name="value" type="smallint"/>
        <field name="ratedAt" column="rated_at" type="datetime_immutable"/>
        <field name="updatedAt" column="updated_at" type="datetime_immutable"/>

    </entity>

</doctrine-mapping>
