<?xml version="1.0" encoding="utf-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <!--
        The username is the primary key: the row exists to hold the name.

        No foreign key to `user`, and `user_id` is nullable, because an alias
        outlives the account that freed it (`FEAT-USR-034`).
    -->
    <entity name="LectoresBeta\User\Profile\Domain\Entity\UsernameAlias"
            table="username_alias" schema="user_ctx">

        <indexes>
            <index name="idx_username_alias_expires" columns="expires_at"/>
            <index name="idx_username_alias_user" columns="user_id"/>
        </indexes>

        <id name="username" type="string" length="30" column="username">
            <generator strategy="NONE"/>
        </id>

        <field name="userId" column="user_id" type="guid" nullable="true"/>
        <field name="reason" type="string" length="24"
               enum-type="LectoresBeta\User\Profile\Domain\Enum\UsernameAliasReason"/>
        <field name="createdAt" column="created_at" type="datetime_immutable"/>
        <field name="expiresAt" column="expires_at" type="datetime_immutable"/>

    </entity>

</doctrine-mapping>
