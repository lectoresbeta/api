<?xml version="1.0" encoding="utf-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="LectoresBeta\User\Profile\Domain\Entity\Genre"
            table="genre" schema="user_ctx">

        <indexes>
            <index name="idx_genre_position" columns="active,position"/>
        </indexes>

        <id name="code" type="string" length="32" column="code">
            <generator strategy="NONE"/>
        </id>

        <field name="name" type="string" length="64"/>
        <field name="position" type="integer"/>
        <field name="active" type="boolean"/>

    </entity>

</doctrine-mapping>
