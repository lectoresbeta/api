<?xml version="1.0" encoding="utf-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="LectoresBeta\User\AuthorPage\Domain\Entity\AuthorPageStyle"
            table="author_page_style" schema="user_ctx">

        <id name="userId" column="user_id" type="guid">
            <generator strategy="NONE"/>
        </id>

        <field name="theme" type="string" length="24"
               enum-type="LectoresBeta\User\AuthorPage\Domain\Enum\AuthorPageTheme"/>
        <field name="accentColour" column="accent_colour" type="string" length="24"
               enum-type="LectoresBeta\User\AuthorPage\Domain\Enum\AccentColour"/>
        <field name="updatedAt" column="updated_at" type="datetime_immutable"/>

    </entity>

</doctrine-mapping>
