<?xml version="1.0" encoding="utf-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <!--
        Blocks, projected from `Community` (`FEAT-COM-034`).

        The **ordered pair** is the primary key: the question here has no
        direction — whether two people are blocked from each other — and
        ordering the pair is what makes reprocessing a fact write the same
        row whoever did the blocking.

        No foreign keys: this is a copy of somebody else's facts.
    -->
    <entity name="LectoresBeta\User\Privacy\Domain\Entity\BlockedPair"
            table="blocked_pair" schema="user_ctx">

        <id name="oneId" column="one_id" type="guid">
            <generator strategy="NONE"/>
        </id>

        <id name="otherId" column="other_id" type="guid">
            <generator strategy="NONE"/>
        </id>

        <field name="blockedAt" column="blocked_at" type="datetime_immutable"/>

    </entity>

</doctrine-mapping>
