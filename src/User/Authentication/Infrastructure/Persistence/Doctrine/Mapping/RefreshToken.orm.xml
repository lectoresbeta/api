<?xml version="1.0" encoding="utf-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="LectoresBeta\User\Authentication\Domain\Entity\RefreshToken"
            table="refresh_token" schema="user_ctx">

        <indexes>
            <!-- «Close every other session» after a password or email change
                 reads by user and revocation state. -->
            <index name="idx_refresh_token_user" columns="user_id,revoked_at"/>
            <index name="idx_refresh_token_expires" columns="expires_at"/>
        </indexes>

        <unique-constraints>
            <unique-constraint name="uniq_refresh_token_hash" columns="token_hash"/>
        </unique-constraints>

        <id name="id" type="guid" column="id">
            <generator strategy="NONE"/>
        </id>

        <field name="userId" column="user_id" type="guid"/>
        <field name="tokenHash" column="token_hash" type="string" length="64"/>
        <field name="issuedAt" column="issued_at" type="datetime_immutable"/>
        <field name="expiresAt" column="expires_at" type="datetime_immutable"/>
        <field name="revokedAt" column="revoked_at" type="datetime_immutable" nullable="true"/>
        <field name="lastUsedAt" column="last_used_at" type="datetime_immutable" nullable="true"/>
        <field name="userAgent" column="user_agent" type="string" length="255" nullable="true"/>

    </entity>

</doctrine-mapping>
