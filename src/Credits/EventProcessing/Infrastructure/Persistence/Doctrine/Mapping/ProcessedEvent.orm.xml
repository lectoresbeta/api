<?xml version="1.0" encoding="utf-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <!-- `(event_id, consumer)` is the key: inserting it twice must fail, and
         that failure is the deduplication (`FEAT-CRD-011` `RN-3`, `RN-4`).
         The event id alone would let the first rule that processes a fact
         mark it done for every other rule. -->
    <entity name="LectoresBeta\Credits\EventProcessing\Domain\Entity\ProcessedEvent"
            table="processed_event" schema="credits_ctx">

        <indexes>
            <!-- Purging old rows reads by date (`FEAT-CRD-011`). -->
            <index name="idx_processed_event_date" columns="processed_at"/>
        </indexes>

        <id name="eventId" column="event_id" type="guid">
            <generator strategy="NONE"/>
        </id>

        <id name="consumer" column="consumer" type="string" length="64">
            <generator strategy="NONE"/>
        </id>

        <field name="eventName" column="event_name" type="string" length="64"/>
        <field name="processedAt" column="processed_at" type="datetime_immutable"/>

    </entity>

</doctrine-mapping>
