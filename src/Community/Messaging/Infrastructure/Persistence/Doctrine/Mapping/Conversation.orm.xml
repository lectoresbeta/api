<?xml version="1.0" encoding="utf-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="LectoresBeta\Community\Messaging\Domain\Entity\Conversation"
            table="conversation" schema="community_ctx">

        <indexes>
            <!-- El orden de la lista, con su desempate dentro: la consulta
                 ordena por los dos, así que el índice los lleva los dos. -->
            <index name="idx_conversation_one" columns="member_one,last_message_at,last_message_id"/>
            <index name="idx_conversation_two" columns="member_two,last_message_at,last_message_id"/>
        </indexes>

        <unique-constraints>
            <unique-constraint name="uniq_conversation_pair" columns="member_one,member_two"/>
        </unique-constraints>

        <id name="id" type="guid" column="id">
            <generator strategy="NONE"/>
        </id>

        <field name="memberOne" column="member_one" type="guid"/>
        <field name="memberTwo" column="member_two" type="guid"/>
        <field name="startedAt" column="started_at" type="datetime_immutable"/>
        <field name="lastMessageAt" column="last_message_at" type="datetime_immutable"/>
        <field name="lastMessageId" column="last_message_id" type="guid" nullable="true"/>

    </entity>

</doctrine-mapping>
