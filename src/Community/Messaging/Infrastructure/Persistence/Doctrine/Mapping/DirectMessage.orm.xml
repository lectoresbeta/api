<?xml version="1.0" encoding="utf-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="LectoresBeta\Community\Messaging\Domain\Entity\DirectMessage"
            table="direct_message" schema="community_ctx">

        <indexes>
            <index name="idx_direct_message_conversation" columns="conversation_id,sent_at"/>
        </indexes>

        <id name="id" type="guid" column="id">
            <generator strategy="NONE"/>
        </id>

        <field name="conversationId" column="conversation_id" type="guid"/>
        <field name="senderId" column="sender_id" type="guid"/>
        <field name="body" type="text"/>
        <field name="sentAt" column="sent_at" type="datetime_immutable"/>
        <field name="readAt" column="read_at" type="datetime_immutable" nullable="true"/>

    </entity>

</doctrine-mapping>
