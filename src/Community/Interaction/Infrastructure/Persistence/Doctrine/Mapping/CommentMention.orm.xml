<?xml version="1.0" encoding="utf-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="LectoresBeta\Community\Interaction\Domain\Entity\CommentMention"
            table="comment_mention" schema="community_ctx">

        <indexes>
            <!-- «Where have I been mentioned» reads this way. -->
            <index name="idx_comment_mention_user" columns="mentioned_user_id"/>
            <index name="idx_comment_mention_comment" columns="comment_id"/>
        </indexes>

        <id name="id" type="guid" column="id">
            <generator strategy="NONE"/>
        </id>

        <field name="commentId" column="comment_id" type="guid"/>
        <field name="mentionedUserId" column="mentioned_user_id" type="guid"/>
        <field name="position" type="integer"/>

    </entity>

</doctrine-mapping>
