<?xml version="1.0" encoding="utf-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <!-- Insert only, and nothing here or in the repository updates a row. -->
    <entity name="LectoresBeta\Moderation\AuditLog\Domain\Entity\AuditEntry"
            table="audit_entry" schema="moderation_ctx">

        <indexes>
            <index name="idx_audit_actor" columns="actor_id,occurred_at"/>
            <index name="idx_audit_target" columns="target_type,target_id,occurred_at"/>
            <index name="idx_audit_action" columns="action,occurred_at"/>
        </indexes>

        <id name="id" type="guid" column="id">
            <generator strategy="NONE"/>
        </id>

        <field name="actorId" column="actor_id" type="guid"/>
        <field name="action" type="string" length="64"/>
        <field name="targetType" column="target_type" type="string" length="32"/>
        <field name="targetId" column="target_id" type="string" length="64"/>
        <field name="reason" type="text" nullable="true"/>
        <field name="payload" type="json">
            <options>
                <option name="jsonb">true</option>
            </options>
        </field>
        <field name="occurredAt" column="occurred_at" type="datetime_immutable"/>

    </entity>

</doctrine-mapping>
