<?xml version="1.0" encoding="utf-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <!-- `thread_party` separates the two private threads of one file. It is
         the column the whole privacy of `FEAT-MOD-009` rests on, so it leads
         the index that reads them. -->
    <entity name="LectoresBeta\Moderation\Review\Domain\Entity\ClaimMessage"
            table="claim_message" schema="moderation_ctx">

        <indexes>
            <index name="idx_claim_message_thread" columns="claim_id,thread_party,sent_at"/>
        </indexes>

        <id name="id" type="guid" column="id">
            <generator strategy="NONE"/>
        </id>

        <field name="claimId" column="claim_id" type="guid"/>
        <field name="threadParty" column="thread_party" type="string" length="16"
               enum-type="LectoresBeta\Moderation\Review\Domain\Enum\ThreadParty"/>
        <field name="authorType" column="author_type" type="string" length="16"
               enum-type="LectoresBeta\Moderation\Review\Domain\Enum\MessageAuthorType"/>
        <field name="authorId" column="author_id" type="guid"/>
        <field name="body" type="text"/>
        <field name="sentAt" column="sent_at" type="datetime_immutable"/>

    </entity>

</doctrine-mapping>
